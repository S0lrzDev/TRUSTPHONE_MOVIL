{
  "expo": {
    "name": "TrustPhone",
    "slug": "TrustPhone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/trustphone-icon.png",
    "scheme": "trustphone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A75",
        "foregroundImage": "./assets/images/trustphone-icon-fg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TrustPhone"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/trustphone-logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/images/trustphone-logo.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#1A202C"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "s0lrzdevs-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53ddc39e-b829-4a03-b955-86e037d36eea"
      }
    }
  }
}
